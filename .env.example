# Settings for the machine that runs the companion.
# Example path: /etc/ha-cozmo-companion.env

# SSID and password are printed on the cube lift of the robot.
COZMO_SSID=Cozmo_XXXXXX
COZMO_PASSWORD=

# Linux interface that should join Cozmo. Leave empty to pick a Wi-Fi
# interface that is not your default route.
COZMO_WIFI_IFACE=

# Cozmo's own access point always uses this address.
COZMO_HOST=172.31.1.1
COZMO_PORT=5551

# Address Home Assistant will call. 0.0.0.0 listens on every interface.
LISTEN=0.0.0.0:8790

# Who may call the HTTP API. Unset means private.
# local          this machine only
# 192.168.0.0/24 that subnet (example)
# private        loopback and private ranges (10/8, 172.16/12, 192.168/16, IPv6 ULA)
# all            any address
# COZMO_ALLOW=private
CAMERA_COLOR=1
COZMO_DRY_RUN=0
